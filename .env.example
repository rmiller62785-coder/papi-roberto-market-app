# Optional: enables SIP trade data and full-session minute aggregates.
# Without it, the app automatically uses a delayed public consolidated feed.
MASSIVE_API_KEY=

# Preferred server-side NVDA market-data source (Alpaca Basic = IEX only).
# These same server-side paper credentials also support the read-only NVDA
# tradability/borrow-status check. It never requests account balances or orders.
# Store production values as encrypted Sites secrets; never expose them client-side.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
