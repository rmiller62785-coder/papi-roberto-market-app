# Server-side provider credentials. Never expose these through NEXT_PUBLIC_*.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FINNHUB_API_KEY=

# Comma-separated authenticated emails allowed to save production research weights.
WEIGHTS_ADMIN_EMAILS=

# Optional durable market-stream receiver. Configure the same audience and
# secret in the separate services/market-stream Worker. Generate a strong
# random secret in the hosting secret manager; never commit its value.
SITES_INGESTION_AUDIENCE=aperture-sites-market-ingestion
SITES_INGESTION_SECRET=
